# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-string
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eyeglynt
DB_USER=eyeglynt_web
DB_PASSWORD=CHANGE_ME_web

# Used by engine_bridge (gaze engine + simulator)
ENGINE_DB_USER=eyeglynt_engine
ENGINE_DB_PASSWORD=CHANGE_ME_engine

# Polling interval for the Live screen (ms) and device-offline threshold (s)
POLL_INTERVAL_MS=2000
DEVICE_OFFLINE_AFTER_S=10

# Code a researcher must enter when registering with the "Researcher" role.
# Only researchers see the full metrics report and the session history.
# Leave empty to disable researcher self-registration.
RESEARCHER_ACCESS_CODE=eyeglynt-research
